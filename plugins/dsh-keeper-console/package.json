{
  "name": "dsh-keeper-console",
  "version": "0.1.0",
  "description": "守岸人参数设置面板：左侧栏入口，收纳朗读（dsh-tts / voice-mode）、异动提醒（keeper-watch）、台灯控制（desk-mi）的常用开关，走 RPC 直达宿主，不过模型。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
